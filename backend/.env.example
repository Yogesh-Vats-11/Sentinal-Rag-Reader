PORT=4000
# Python interpreter that has the project's requirements installed.
# Leave as "python" and the backend will automatically use a virtualenv found in
# the python/ folder (venv, .venv, venv310, ...). Or give a full path, e.g.
# PYTHON_BIN=C:\Users\you\sentinel-rag-project\python\venv310\Scripts\python.exe
PYTHON_BIN=python
# Path to the python/ folder, relative to the backend folder (or absolute)
PYTHON_DIR=../python
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
