# LLM_BACKEND=ollama runs fully locally, no key needed (default)
# LLM_BACKEND=openai uses OpenAI's hosted API and needs OPENAI_API_KEY below
LLM_BACKEND=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Only used when LLM_BACKEND=openai
OPENAI_API_KEY=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=3

# --- Speed (all optional) ---
# keep the Ollama model in memory between questions
LLM_KEEP_ALIVE=30m
# max length of one answer, in tokens
MAX_TOKENS=400
# smaller context window = less RAM, faster (leave unset for Ollama's default)
OLLAMA_NUM_CTX=2048
# earlier messages sent along in a normal chat (more = slower)
HISTORY_MESSAGES=6
HISTORY_CHARS=800
# load models when the backend starts so the first question is fast
WARMUP=true
